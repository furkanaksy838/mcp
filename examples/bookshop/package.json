{
  "name": "@capire/bookshop",
  "version": "2.1.11",
  "description": "Our primer sample for getting started in a nutshell.",
  "repository": "https://github.com/capire/bookshop",
  "files": [
    "app",
    "srv",
    "db",
    "index.cds"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": ">=2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "@sap/cds": ">=9.6.2",
    "cap-mcp-guard": "file:../.."
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest"
  },
  "license": "Apache-2.0",
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "cap-mcp-guard": {
    "mode": "observe",
    "entities": {
      "CatalogService.Books": {
        "mask": ["descr", "price"],
        "maxRows": 50,
        "allowTools": ["ReadBooks"]
      },
      "AdminService.Authors": {
        "mask": ["dateOfDeath"]
      }
    }
  }
}
